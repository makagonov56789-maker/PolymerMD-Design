units real
atom_style full
boundary p p p

variable dt equal 1

pair_style lj/cut/coul/long 10
bond_style harmonic
angle_style harmonic
dihedral_style fourier
improper_style cvff
special_bonds amber
pair_modify tail yes mix arithmetic
kspace_style pppm 1.0e-4

read_data relaxed_ultem_10ns.data

timestep ${dt}

dump 2 all custom 50000 dump.*.lammpstrj id type x y z

# =========================================================
# 1. РЕЛАКСАЦИЯ (видимый контроль)
# =========================================================
print "===== STAGE 1: INITIAL RELAXATION ====="

fix 1 all nvt temp 300.0 300.0 100.0

thermo 1000
thermo_style custom step temp pe ke etotal press lx ly lz pzz

run 5000

unfix 1

# =========================================================
# 2. СТАРТОВЫЕ ЗНАЧЕНИЯ
# =========================================================
variable Lx0 equal lx
variable Ly0 equal ly
variable Lz0 equal lz
variable Pzz0 equal pzz

print "Equilibrated state:"
print "Lx = ${Lx0}"
print "Ly = ${Ly0}"
print "Lz = ${Lz0}"
print "Pzz = ${Pzz0}"

# =========================================================
# 3. ДЕФОРМАЦИЯ (production)
# =========================================================
print "===== STAGE 3: UNIAXIAL DEFORMATION ====="

fix 2 all npt temp 300.0 300.0 100.0 x 1.0 1.0 1000.0 y 1.0 1.0 1000.0
fix 3 all deform 1 z erate 5e-8 units box remap x

# =========================================================
# 6. STRAIN / STRESS
# =========================================================
variable strain_z equal (lz-${Lz0})/${Lz0}
variable strain_x equal (lx-${Lx0})/${Lx0}
variable strain_y equal (ly-${Ly0})/${Ly0}

variable stress_z equal -(pzz-${Pzz0})/10.0

# =========================================================
# 7. MONITORING (каждые 1000 шагов)
# =========================================================
thermo 1000
thermo_style custom step temp lx ly lz pzz v_strain_z v_strain_x v_strain_y v_stress_z

thermo_modify flush yes

fix stress_ave all ave/time 100 10 1000 v_strain_z v_strain_x v_strain_y v_stress_z file stress_strain.dat

run 1000000

print "===== SIMULATION COMPLETE ====="
print "===== DEFORMATION COMPLETE ====="
print "Final strain_z = ${strain_z}"
print "Final stress_z = ${stress_z} MPa"

write_data mech_ultem.data