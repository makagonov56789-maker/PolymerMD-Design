# 2. СТАРТОВЫЕ ЗНАЧЕНИЯ
# =========================================================
variable Lx0 equal lx
variable Ly0 equal ly
variable Lz0 equal lz
variable Pzz0 equal pzz

print "Equilibrated state:"
