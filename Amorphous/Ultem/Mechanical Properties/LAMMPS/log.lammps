print "Lx = ${Lx0}"
Lx = 51.385526387773
print "Ly = ${Ly0}"
Ly = 51.385526387773
print "Lz = ${Lz0}"
Lz = 51.385526387773
print "Pzz = ${Pzz0}"
Pzz = -573.076867310029

# =========================================================
# 3. ДЕФОРМАЦИЯ (production)
# =========================================================
print "===== STAGE 3: UNIAXIAL DEFORMATION ====="
===== STAGE 3: UNIAXIAL DEFORMATION =====

fix 2 all npt temp 300.0 300.0 100.0 x 1.0 1.0 1000.0 y 1.0 1.0 1000.0
fix 3 all deform 1 z erate 5e-8 units box remap x

# =========================================================
# 6. STRAIN / STRESS
# =========================================================
variable strain_z equal (lz-${Lz0})/${Lz0}
variable strain_z equal (lz-51.385526387773)/${Lz0}
variable strain_z equal (lz-51.385526387773)/51.385526387773
variable strain_x equal (lx-${Lx0})/${Lx0}
variable strain_x equal (lx-51.385526387773)/${Lx0}
variable strain_x equal (lx-51.385526387773)/51.385526387773
variable strain_y equal (ly-${Ly0})/${Ly0}
variable strain_y equal (ly-51.385526387773)/${Ly0}
variable strain_y equal (ly-51.385526387773)/51.385526387773

variable stress_z equal -(pzz-${Pzz0})/10.0
variable stress_z equal -(pzz--573.076867310029)/10.0

# =========================================================
# 7. MONITORING (каждые 1000 шагов)
# =========================================================
thermo 1000
thermo_style custom step temp lx ly lz pzz v_strain_z v_strain_x v_strain_y v_stress_z

thermo_modify flush yes

fix stress_ave all ave/time 100 10 1000 v_strain_z v_strain_x v_strain_y v_stress_z file stress_strain.dat

run 1000000
