unfix           1

# 4. Переключаемся на NVE
fix             2 all nve

# 5. RNEMD метод
# Обмен энергией каждые 20 шагов между 1 и 20 слоями
fix             3 all thermal/conductivity ${Nexchange} x ${Nbin}
fix             3 all thermal/conductivity 20 x ${Nbin}
fix             3 all thermal/conductivity 20 x 20

# 6. Мониторинг
# Выводим температуру и переданную энергию
thermo_style    custom step temp epair etotal f_3 lx
thermo          1000

# 7. ЗАПУСК - используем небольшое число для отладки
run             10000
