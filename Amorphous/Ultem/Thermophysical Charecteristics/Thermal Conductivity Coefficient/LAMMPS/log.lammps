  special bonds CPU = 0.002 seconds
  read_data CPU = 0.268 seconds

# 2. Создаем папку checkpoints
shell mkdir checkpoints

dump 2 all custom 50000 ./checkpoints/smth.*.pos id type x y z

# Параметры
variable        Nexchange equal 20
variable Nbin equal 20

# ширина слоя вручную (или посчитай заранее)
compute layers all chunk/atom bin/1d x lower 2.57 units box

fix temp_profile all ave/chunk 100 1000 100000 layers temp file temp.profile

# 3. Сначала термостатирование
# Используем NVT с релаксацией
fix             1 all nvt temp 300.0 300.0 100.0
thermo          1000
thermo_style    custom step temp vol

run             10000

