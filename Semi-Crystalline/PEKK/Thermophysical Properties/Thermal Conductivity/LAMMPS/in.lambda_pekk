units           real
atom_style      full
boundary        p p p

variable        dt equal 1.0
timestep        ${dt}

pair_style      lj/cut/coul/long 10
bond_style      harmonic
angle_style     harmonic
dihedral_style  fourier
improper_style  cvff 
special_bonds   amber  
pair_modify     tail yes mix arithmetic
kspace_style    pppm 1.0e-4

# 1. Загрузка структуры
read_data       relaxed_pekk.data

# 2. Создаем папку checkpoints
shell mkdir checkpoints

dump 2 all custom 50000 ./checkpoints/smth.*.pos id type x y z 

# Параметры
variable        Nexchange equal 20
variable Nbin equal 20

# ширина слоя вручную 
compute layers all chunk/atom bin/1d x lower 2.57 units box

fix temp_profile all ave/chunk 100 1000 100000 layers temp file temp.profile

# 3. Сначала термостатирование
# Используем NVT с релаксацией
fix             1 all nvt temp 300.0 300.0 100.0
thermo          1000
thermo_style    custom step temp vol

run             10000
unfix           1

# 4. Переключаемся на NVE
fix             2 all nve

# 5. RNEMD метод 
# Обмен энергией каждые 20 шагов между 1 и 20 слоями
fix             3 all thermal/conductivity ${Nexchange} x ${Nbin}

# 6. Мониторинг
# Выводим температуру и переданную энергию
thermo_style    custom step temp epair etotal f_3 lx
thermo          1000

# 7. ЗАПУСК - используем небольшое число для отладки
run             10000

print "Checkpoint reached"

# 8. Основной запуск (если отладка успешна)
run            1000000

write_data      structure_pekk_thermal.data