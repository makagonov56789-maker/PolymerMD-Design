units real
atom_style full
boundary p p p

variable    dt equal 1

pair_style      lj/cut/coul/long 10
bond_style      harmonic
angle_style     harmonic
dihedral_style  fourier
improper_style  cvff 
special_bonds   amber  
pair_modify     tail yes mix arithmetic
kspace_style    pppm 1.0e-4

read_data relaxed_pekk.data

shell mkdir checkpoints

dump           2 all custom 10000 ./checkpoints/smth.*.pos id type x y z 

thermo_style custom step temp press density evdwl ecoul ebond eangle edihed eimp vol pe ke pxx pyy pzz pxy pxz pyz enthalpy fmax
thermo_modify flush yes
thermo 1000

timestep ${dt}

fix 0 all npt temp 800 800 100 iso 1 1 1000
run 50000
unfix 0

fix 1 all npt temp 800 300 100 iso 1 1 1000  
run 1000000
write_data pekk_temp.data
